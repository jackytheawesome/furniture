# PostgreSQL (local via docker-compose, Neon/Supabase in production)
DATABASE_URL="postgresql://furniture:furniture@localhost:5432/furniture?schema=public"
# Optional: direct connection for migrations when DATABASE_URL uses a pooler (Neon)
# DIRECT_URL="postgresql://..."

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
